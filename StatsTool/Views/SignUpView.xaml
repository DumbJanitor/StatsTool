<UserControl x:Class="StatsTool.Views.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <!--
        ========================================================
        SALESSCOPE - SIGN UP VIEW
        ========================================================

        FRONTEND:
        - Uses the same design as LoginView.
        - Displayed inside MainWindow.AuthContent.
        - Back returns to LoginView.
        - Responsive scaling uses Viewbox.
        - No changes to MainWindow are required.
        - Username and email text must remain fully visible.
        - The Show/Hide control affects ONLY the password.
        - Google's button is text-only: "Sign up with Google".

        BACKEND TEAM:
        - Connect Sign Up to account registration.
        - Validate user information on the server.
        - Check for duplicate usernames and emails.
        - Implement Google OAuth authentication.
        - Return registration errors to this view.
        - Never store passwords in plain text.
        - PasswordInput remains the password source after Show/Hide.

        DATABASE TEAM:
        - Define user account records.
        - Enforce unique usernames and email addresses.
        - Coordinate secure password storage with backend.
        - Do not put SQL queries inside this UserControl.
    -->

    <Grid Background="White">

        <Viewbox Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="25,55,25,35">

            <!-- MAIN SIGN UP CARD -->
            <Border Width="420"
                    Padding="34,25,34,30"
                    Background="White"
                    BorderBrush="#E1E6ED"
                    BorderThickness="1"
                    CornerRadius="12">

                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="18"
                                      ShadowDepth="2"
                                      Opacity="0.09"/>
                </Border.Effect>

                <StackPanel>

                    <!-- BACK TO LOGIN -->
                    <Button Content="← Back"
                            Click="BackButton_Click"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#61718D"
                            FontSize="13"
                            Cursor="Hand"
                            Padding="0"
                            Margin="0,0,0,18"/>

                    <!-- SALESSCOPE LOGO -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,26">

                        <Grid Width="34"
                              Height="34"
                              Margin="0,0,9,0">

                            <Ellipse Fill="#009F91"/>

                            <Path Data="M 17,0 L 17,17 L 34,17
                                        M 17,17 L 29,29"
                                  Stroke="White"
                                  StrokeThickness="2.7"/>

                        </Grid>

                        <TextBlock Text="SalesScope"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#0B1530"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- USERNAME: visible text without clipped padding -->
                    <TextBlock Text="USERNAME"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource SSInputStyle}"
                             Height="42"
                             MaxLength="100"
                             Margin="0,0,0,18"
                             Padding="12,0"
                             VerticalContentAlignment="Center"/>

                    <!-- EMAIL: fully visible, never masked -->
                    <TextBlock Text="EMAIL"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource SSInputStyle}"
                             Height="42"
                             MaxLength="254"
                             Margin="0,0,0,18"
                             Padding="12,0"
                             VerticalContentAlignment="Center"/>

                    <!-- PASSWORD: hidden by default; Show/Hide switches
                         to an ordinary text box only when requested. -->
                    <TextBlock Text="PASSWORD"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <Grid Height="42" Margin="0,0,0,20">

                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource SSPasswordStyle}"
                                     Height="42"
                                     Padding="12,0,58,0"
                                     VerticalContentAlignment="Center"/>

                        <TextBox x:Name="VisiblePasswordTextBox"
                                 Style="{StaticResource SSInputStyle}"
                                 Height="42"
                                 Padding="12,0,58,0"
                                 VerticalContentAlignment="Center"
                                 Visibility="Collapsed"/>

                        <Button x:Name="PasswordVisibilityButton"
                                Content="Show"
                                Click="PasswordVisibilityButton_Click"
                                Width="54"
                                Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#008E83"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Show or hide password"/>

                    </Grid>

                    <!-- SIGN UP BUTTON -->
                    <Button x:Name="SignUpButton"
                            Content="Sign Up"
                            Style="{StaticResource SSPrimaryButtonStyle}"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            Click="SignUpButton_Click"
                            Margin="0,0,0,18"/>

                    <!-- DIVIDER -->
                    <Grid Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#E1E6ED"
                                Height="1"
                                VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="OR"
                                   Foreground="#8390A4"
                                   FontSize="11"
                                   Margin="14,0"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Column="2"
                                Background="#E1E6ED"
                                Height="1"
                                VerticalAlignment="Center"/>

                    </Grid>

                    <!-- GOOGLE SIGN UP: text only; no blue "G" -->
                    <Button x:Name="GoogleSignUpButton"
                            Content="Sign up with Google"
                            Click="GoogleSignUpButton_Click"
                            Style="{StaticResource SSOutlineButtonStyle}"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            Background="White"
                            Foreground="#0B1530"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <!-- VALIDATION / INTEGRATION FEEDBACK -->
                    <TextBlock x:Name="FeedbackText"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Margin="0,15,0,0"/>

                </StackPanel>

            </Border>

        </Viewbox>

    </Grid>

</UserControl>