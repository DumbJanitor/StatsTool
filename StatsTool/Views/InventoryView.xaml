<UserControl x:Class="StatsTool.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="InventoryView_Loaded"
             FontFamily="Segoe UI">

    <!--
    ============================================================
    SALESSCOPE - INVENTORY VIEW
    ============================================================

    FRONTEND TEAM:
    - This view is loaded inside the existing MainWindow.
    - Do not create another Window, sidebar, or title bar.
    - Inventory is primarily for viewing and filtering products.
    - Users can switch between weekly records and all products.
    - Add/Edit/Delete controls are secondary management actions.
    - Quantity changes belong primarily to DailyEntryView.
    - The product table scrolls horizontally on narrower screens.

    BACKEND TEAM:
    - Load product records and weekly inventory information.
    - Implement week-based filtering and product search.
    - Connect Add, Edit, and Delete actions.
    - Refresh inventory after saved Daily Entry transactions.
    - Preserve historical reporting records.
    - Use LoadInventory(...) as the integration point.

    DATABASE TEAM:
    - Maintain product IDs, names, categories, and selling units.
    - Maintain product creation and modification timestamps.
    - Supply weekly sales totals and stock snapshots.
    - Link weekly records to products using product IDs.
    - Preserve history when products are deleted or archived.
    - Coordinate product status calculations with backend.

    IMPORTANT:
    The current records are frontend samples, not database data.
    ============================================================
    -->

    <UserControl.Resources>

        <Style x:Key="InventoryCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E3EAF1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>

        <Style x:Key="InventoryLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#0B1530"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

        <Style x:Key="InventoryActionButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#009F91"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#008D81"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="9,5"/>

            <Setter Property="Margin"
                    Value="3,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </UserControl.Resources>

    <Grid Background="#FCFDFE">

        <!-- =================================================
             MAIN INVENTORY CONTENT
             ================================================= -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="20">

                <!-- PAGE HEADING -->
                <Grid Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Inventory"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0B1530"/>

                        <TextBlock Text="View and manage products across reporting weeks"
                                   FontSize="14"
                                   Foreground="#526482"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="+ Add Product"
                            Style="{StaticResource SSOutlineButtonStyle}"
                            Width="190"
                            Height="42"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Click="AddProductButton_Click"/>

                </Grid>

                <!-- =================================================
                     VIEW AND FILTER CONTROLS
                     ================================================= -->

                <Border Style="{StaticResource InventoryCardStyle}">

                    <StackPanel>

                        <!-- VIEW MODE AND CALENDAR -->
                        <WrapPanel VerticalAlignment="Center">

                            <TextBlock Text="View:"
                                       Style="{StaticResource InventoryLabelStyle}"
                                       Margin="0,0,12,0"/>

                            <Button x:Name="AllProductsButton"
                                    Content="All Products"
                                    Style="{StaticResource SSOutlineButtonStyle}"
                                    Height="36"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Click="AllProductsButton_Click"/>

                            <Button x:Name="WeeklyViewButton"
                                    Content="By Week"
                                    Style="{StaticResource SSOutlineButtonStyle}"
                                    Height="36"
                                    MinWidth="95"
                                    Margin="0,0,18,8"
                                    Click="WeeklyViewButton_Click"/>

                            <TextBlock Text="Week:"
                                       Style="{StaticResource InventoryLabelStyle}"
                                       Margin="0,0,10,8"/>

                            <Button x:Name="PreviousWeekButton"
                                    Content="‹"
                                    Width="34"
                                    Height="36"
                                    FontSize="20"
                                    Background="White"
                                    BorderBrush="#C9D5E1"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Margin="0,0,6,8"
                                    Click="PreviousWeekButton_Click"/>

                            <DatePicker x:Name="WeekDatePicker"
                                        Width="145"
                                        Height="36"
                                        FirstDayOfWeek="Monday"
                                        Margin="0,0,6,8"
                                        SelectedDateChanged="WeekDatePicker_SelectedDateChanged"/>

                            <Button x:Name="NextWeekButton"
                                    Content="›"
                                    Width="34"
                                    Height="36"
                                    FontSize="20"
                                    Background="White"
                                    BorderBrush="#C9D5E1"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Margin="0,0,8,8"
                                    Click="NextWeekButton_Click"/>

                        </WrapPanel>

                        <!-- SEARCH AND STATUS FILTER -->
                        <WrapPanel Margin="0,10,0,0">

                            <TextBlock Text="Search:"
                                       Style="{StaticResource InventoryLabelStyle}"
                                       Margin="0,0,10,8"/>

                            <TextBox x:Name="SearchTextBox"
                                     Style="{StaticResource SSInputStyle}"
                                     Width="250"
                                     Height="36"
                                     Margin="0,0,22,8"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>

                            <TextBlock Text="Status:"
                                       Style="{StaticResource InventoryLabelStyle}"
                                       Margin="0,0,10,8"/>

                            <ComboBox x:Name="StatusFilter"
                                      Width="165"
                                      Height="36"
                                      SelectedIndex="0"
                                      Background="White"
                                      Foreground="#0B1530"
                                      BorderBrush="#C9D5E1"
                                      Margin="0,0,8,8"
                                      SelectionChanged="StatusFilter_SelectionChanged">

                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Below average"/>
                                <ComboBoxItem Content="Sufficient"/>
                                <ComboBoxItem Content="No history"/>

                            </ComboBox>

                        </WrapPanel>

                    </StackPanel>

                </Border>

                <!-- =================================================
                     INVENTORY PRODUCT TABLE
                     ================================================= -->

                <Border Style="{StaticResource InventoryCardStyle}">

                    <StackPanel>

                        <!-- TABLE HEADING -->
                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock x:Name="CurrentViewLabel"
                                           Text="Selected Week"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#0B1530"/>

                                <TextBlock x:Name="WeekRangeLabel"
                                           FontSize="13"
                                           Foreground="#173A84"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                            <TextBlock x:Name="ProductCountLabel"
                                       Grid.Column="1"
                                       FontSize="13"
                                       Foreground="#526482"
                                       VerticalAlignment="Center"/>

                        </Grid>

                        <!-- DATA TABLE -->
                        <DataGrid x:Name="ProductsGrid"
                                  Height="415"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  RowHeight="46"
                                  ColumnHeaderHeight="38"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5EBF2"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternatingRowBackground="#F8FAFC"
                                  AlternationCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background"
                                            Value="#EAF0F4"/>

                                    <Setter Property="Foreground"
                                            Value="#0B1530"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                    <Setter Property="FontSize"
                                            Value="12"/>

                                    <Setter Property="Padding"
                                            Value="10,0"/>

                                    <Setter Property="BorderThickness"
                                            Value="0"/>

                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>

                                </Style>

                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Product"
                                                    Binding="{Binding Product}"
                                                    Width="165"/>

                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="115"/>

                                <DataGridTextColumn x:Name="UnitsSoldColumn"
                                                    Header="Units Sold"
                                                    Binding="{Binding UnitsSoldText}"
                                                    Width="95"/>

                                <DataGridTextColumn x:Name="StockColumn"
                                                    Header="In Stock"
                                                    Binding="{Binding Stock}"
                                                    Width="85"/>

                                <DataGridTextColumn Header="Weekly Avg."
                                                    Binding="{Binding WeeklyAverageText}"
                                                    Width="100"/>

                                <!-- STOCK STATUS -->
                                <DataGridTemplateColumn Header="Status"
                                                        Width="125">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Background="{Binding StatusBackground}"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="4,0"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{Binding StatusForeground}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Date Added"
                                                    Binding="{Binding DateAddedText}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Last Modified"
                                                    Binding="{Binding LastModifiedText}"
                                                    Width="115"/>

                                <!-- PRODUCT ACTIONS -->
                                <DataGridTemplateColumn Header="Actions"
                                                        Width="145">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                <Button Content="Edit"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource InventoryActionButtonStyle}"
                                                        Click="EditProductButton_Click"/>

                                                <Button Content="Delete"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource InventoryActionButtonStyle}"
                                                        Foreground="#C74747"
                                                        BorderBrush="#E7B5B5"
                                                        Click="DeleteProductButton_Click"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- DAILY ENTRY REMINDER -->
                        <Border BorderBrush="#E3EAF1"
                                BorderThickness="0,1,0,0"
                                Margin="0,16,0,0"
                                Padding="0,14,0,0">

                            <WrapPanel>

                                <TextBlock Text="Record sales and stock changes through Daily Entry."
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="#526482"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,6"/>

                                <Button Click="DailyEntryButton_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        Margin="0,0,0,6">

                                    <TextBlock Text="Open Daily Entry"
                                               Foreground="#009F91"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               TextDecorations="Underline"/>

                                </Button>

                            </WrapPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- =================================================
             ADD / EDIT PRODUCT OVERLAY
             =================================================
             This overlay belongs to InventoryView.
             No new Window or page is required.
             ================================================= -->

        <Grid x:Name="EditorOverlay"
              Background="#990B1530"
              Visibility="Collapsed"
              Panel.ZIndex="10">

            <Border Width="450"
                    Padding="26"
                    Background="White"
                    BorderBrush="#E3EAF1"
                    BorderThickness="1"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock x:Name="EditorTitle"
                               Text="Add Product"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#0B1530"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Edit product details here. Record stock quantities in Daily Entry."
                               FontSize="12"
                               Foreground="#526482"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"/>

                    <!-- PRODUCT NAME -->
                    <TextBlock Text="PRODUCT NAME"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="ProductNameInput"
                             Style="{StaticResource SSInputStyle}"
                             Height="40"
                             MaxLength="100"
                             Margin="0,0,0,16"/>

                    <!-- CATEGORY -->
                    <TextBlock Text="CATEGORY"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="CategoryInput"
                             Style="{StaticResource SSInputStyle}"
                             Height="40"
                             MaxLength="60"
                             Margin="0,0,0,16"/>

                    <!-- SELLING UNIT -->
                    <TextBlock Text="SELLING UNIT"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="SellingUnitInput"
                             Style="{StaticResource SSInputStyle}"
                             Height="40"
                             MaxLength="60"
                             Margin="0,0,0,16"/>

                    <!-- VALIDATION -->
                    <TextBlock x:Name="EditorErrorText"
                               Visibility="Collapsed"
                               FontSize="12"
                               Foreground="#C74747"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- EDITOR BUTTONS -->
                    <Grid Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Style="{StaticResource SSOutlineButtonStyle}"
                                Height="42"
                                Click="CancelEditorButton_Click"/>

                        <Button Grid.Column="2"
                                Content="Save Product"
                                Style="{StaticResource SSPrimaryButtonStyle}"
                                Height="42"
                                Click="SaveProductButton_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>