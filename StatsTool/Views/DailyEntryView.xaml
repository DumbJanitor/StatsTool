<UserControl x:Class="StatsTool.Views.DailyEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="DailyEntryView_Loaded"
             SizeChanged="DailyEntryView_SizeChanged"
             FontFamily="Segoe UI">

    <!--
    ============================================================
    SALESSCOPE - DAILY ENTRY
    ============================================================

    FRONTEND TEAM:
    - Preserve the two-panel desktop layout.
    - MainWindow owns the title bar and sidebar.
    - Product Category and Selling Unit are linked dropdowns.
    - Product names remain editable text.
    - Preview Changes never saves records.

    BACKEND TEAM:
    - Validate product/category/unit combinations.
    - Connect product creation, editing, and archival.
    - Connect daily entry submission and batch import.
    - Refresh Dashboard and Inventory after successful saves.

    DATABASE TEAM:
    - Product categories and selling units should use stable
      identifiers, rather than relying only on display text.
    - ProductId must link products to daily-entry records.
    - Store reported stock separately from quantities sold.
    - Preserve historical records when products are archived.
    - Coordinate the category/unit catalog with backend.

    The available dropdown choices are defined in the
    code-behind until the shared product catalog is integrated.
    ============================================================
    -->

    <UserControl.Resources>

        <Style x:Key="DailyCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DCE5EF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="Margin"
                    Value="8"/>

            <Setter Property="MinHeight"
                    Value="585"/>

        </Style>

        <Style x:Key="DailyHeadingStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="22"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#0B1530"/>

        </Style>

        <Style x:Key="DailyFieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#0B1530"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

        <Style x:Key="DailyMetricCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FAFCFE"/>

            <Setter Property="BorderBrush"
                    Value="#DCE5EF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="9"/>

            <Setter Property="Margin"
                    Value="3"/>

            <Setter Property="MinHeight"
                    Value="88"/>

        </Style>

        <!-- Dropdowns used in the product editor -->
        <Style x:Key="ProductEditorComboStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#0B1530"/>

            <Setter Property="BorderBrush"
                    Value="#CBD6E4"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="IsEditable"
                    Value="False"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>

    </UserControl.Resources>

    <Grid Background="#FCFDFE">

        <!-- MAIN PAGE -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="12,12,12,16">

                <StackPanel Margin="12,0,12,10">

                    <TextBlock Text="Daily Entry"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0B1530"/>

                    <TextBlock Text="Record sales at the end of the day"
                               FontSize="14"
                               Foreground="#526482"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <!-- RESPONSIVE SIDE-BY-SIDE PANELS -->
                <UniformGrid x:Name="MainPanels"
                             Columns="2">

                    <!-- LEFT: ENTRY FORM -->
                    <Border Style="{StaticResource DailyCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Daily Sales Entry &amp; Products"
                                       Style="{StaticResource DailyHeadingStyle}"
                                       Margin="0,0,0,18"/>

                            <!-- REPORTING DATE -->
                            <Grid Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Reporting Date"
                                           Style="{StaticResource DailyFieldLabelStyle}"/>

                                <DatePicker x:Name="ReportingDatePicker"
                                            Grid.Column="1"
                                            Height="40"
                                            FirstDayOfWeek="Monday"
                                            SelectedDateChanged="ReportingDatePicker_SelectedDateChanged"/>

                            </Grid>

                            <!-- EXISTING PRODUCT -->
                            <Grid Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Select Existing Product"
                                           Style="{StaticResource DailyFieldLabelStyle}"
                                           TextWrapping="Wrap"/>

                                <ComboBox x:Name="ProductComboBox"
                                          Grid.Column="1"
                                          Height="42"
                                          DisplayMemberPath="DisplayName"
                                          Background="White"
                                          Foreground="#0B1530"
                                          BorderBrush="#CBD6E4"
                                          SelectionChanged="ProductComboBox_SelectionChanged"/>

                            </Grid>

                            <!-- PRODUCT ACTIONS -->
                            <Grid Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Add Product"
                                        Height="38"
                                        FontSize="12"
                                        Padding="4,0"
                                        Style="{StaticResource SSOutlineButtonStyle}"
                                        Click="AddProductButton_Click"/>

                                <Button Grid.Column="2"
                                        Content="Edit Product"
                                        Height="38"
                                        FontSize="12"
                                        Padding="4,0"
                                        Style="{StaticResource SSOutlineButtonStyle}"
                                        Click="EditProductButton_Click"/>

                                <Button Grid.Column="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ArchiveProductButton_Click">

                                    <TextBlock Text="Archive Product"
                                               Foreground="#008D81"
                                               TextDecorations="Underline"
                                               FontSize="12"
                                               TextAlignment="Center"/>

                                </Button>

                            </Grid>

                            <!-- PRODUCT DETAILS -->
                            <Border Background="#F0F3F7"
                                    CornerRadius="7"
                                    Padding="12,11"
                                    Margin="0,0,0,18">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal">

                                        <TextBlock Text="Category: "
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#0B1530"/>

                                        <TextBlock x:Name="CategoryValueText"
                                                   FontSize="12"
                                                   Foreground="#0B1530"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#B9C7D9"/>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Margin="10,0,0,0">

                                        <TextBlock Text="Selling Unit: "
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#0B1530"/>

                                        <TextBlock x:Name="SellingUnitValueText"
                                                   FontSize="12"
                                                   Foreground="#0B1530"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- QUANTITY SOLD -->
                            <Grid Margin="0,0,0,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Quantity Sold Today"
                                           Style="{StaticResource DailyFieldLabelStyle}"
                                           TextWrapping="Wrap"/>

                                <TextBox x:Name="QuantitySoldInput"
                                         Grid.Column="1"
                                         Style="{StaticResource SSInputStyle}"
                                         Height="42"
                                         Padding="12,0"
                                         MaxLength="9"
                                         VerticalContentAlignment="Center"/>

                                <TextBlock x:Name="SoldUnitText"
                                           Grid.Column="2"
                                           Foreground="#526482"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="7,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                            </Grid>

                            <!-- AVAILABLE STOCK -->
                            <Grid Margin="0,0,0,18">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Available Stock"
                                               Style="{StaticResource DailyFieldLabelStyle}"/>

                                    <TextBlock Text="Manually enter current stock"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="#526482"
                                               TextWrapping="Wrap"
                                               Margin="0,3,8,0"/>

                                </StackPanel>

                                <TextBox x:Name="AvailableStockInput"
                                         Grid.Column="1"
                                         Style="{StaticResource SSInputStyle}"
                                         Height="42"
                                         Padding="12,0"
                                         MaxLength="9"
                                         VerticalContentAlignment="Center"/>

                                <TextBlock x:Name="StockUnitText"
                                           Grid.Column="2"
                                           Foreground="#526482"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="7,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                            </Grid>

                            <Border Background="#E1E8F0"
                                    Height="1"
                                    Margin="0,0,0,16"/>

                            <!-- BATCH IMPORT -->
                            <WrapPanel Margin="0,0,0,6">

                                <Button Content="Load Batch File"
                                        Width="170"
                                        Height="39"
                                        Style="{StaticResource SSOutlineButtonStyle}"
                                        Margin="0,0,12,6"
                                        Click="LoadBatchFileButton_Click"/>

                                <TextBlock Text="Import multiple daily entries"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="#526482"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,6"/>

                            </WrapPanel>

                            <TextBlock x:Name="BatchFileInfoText"
                                       FontSize="11"
                                       Foreground="#526482"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Visibility="Collapsed"/>

                            <Border Background="#E1E8F0"
                                    Height="1"
                                    Margin="0,10,0,14"/>

                            <!-- FEEDBACK -->
                            <TextBlock x:Name="EntryFeedbackText"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Visibility="Collapsed"/>

                            <!-- PREVIEW / SAVE -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Preview Changes"
                                        Height="44"
                                        Style="{StaticResource SSOutlineButtonStyle}"
                                        Click="PreviewChangesButton_Click"/>

                                <Button Grid.Column="2"
                                        Content="Save Entry"
                                        Height="44"
                                        Style="{StaticResource SSPrimaryButtonStyle}"
                                        Click="SaveEntryButton_Click"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- RIGHT: SALES PREVIEW -->
                    <Border Style="{StaticResource DailyCardStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Current Week — Sales Preview"
                                       Style="{StaticResource DailyHeadingStyle}"/>

                            <WrapPanel Grid.Row="1"
                                       Margin="0,10,0,14">

                                <TextBlock x:Name="PreviewWeekText"
                                           FontSize="14"
                                           Foreground="#173A84"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,4"/>

                                <Border x:Name="PreviewStatusBorder"
                                        Background="#D5F7EB"
                                        CornerRadius="6"
                                        Padding="9,5"
                                        Margin="0,0,0,4">

                                    <TextBlock x:Name="PreviewStatusText"
                                               Text="Unsaved Preview"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#008979"/>

                                </Border>

                            </WrapPanel>

                            <!-- SUMMARY METRICS -->
                            <UniformGrid Grid.Row="2"
                                         Columns="3"
                                         Margin="-3,0,-3,0">

                                <Border Style="{StaticResource DailyMetricCardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="Weekly Units Sold"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#0B1530"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,9"/>

                                        <WrapPanel>

                                            <TextBlock x:Name="WeeklyUnitsBeforeText"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#0B1530"/>

                                            <TextBlock Text=" → "
                                                       FontSize="16"
                                                       Foreground="#0B1530"/>

                                            <TextBlock x:Name="WeeklyUnitsAfterText"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#0B1530"/>

                                            <TextBlock x:Name="WeeklyDeltaText"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#009F91"
                                                       Margin="5,5,0,0"/>

                                        </WrapPanel>

                                    </StackPanel>

                                </Border>

                                <Border Style="{StaticResource DailyMetricCardStyle}">

                                    <StackPanel>

                                        <TextBlock x:Name="PreviewProductNameText"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#0B1530"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,9"/>

                                        <WrapPanel>

                                            <TextBlock x:Name="ProductUnitsBeforeText"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#0B1530"/>

                                            <TextBlock Text=" → "
                                                       FontSize="16"
                                                       Foreground="#0B1530"/>

                                            <TextBlock x:Name="ProductUnitsAfterText"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#0B1530"/>

                                            <TextBlock x:Name="ProductDeltaText"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#009F91"
                                                       Margin="5,5,0,0"/>

                                        </WrapPanel>

                                    </StackPanel>

                                </Border>

                                <Border Style="{StaticResource DailyMetricCardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="Products Sold"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#0B1530"
                                                   Margin="0,0,0,9"/>

                                        <WrapPanel>

                                            <TextBlock x:Name="ProductsBeforeText"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#0B1530"/>

                                            <TextBlock Text=" → "
                                                       FontSize="16"
                                                       Foreground="#0B1530"/>

                                            <TextBlock x:Name="ProductsAfterText"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#0B1530"/>

                                        </WrapPanel>

                                    </StackPanel>

                                </Border>

                            </UniformGrid>

                            <Border Grid.Row="3"
                                    Background="#E1E8F0"
                                    Height="1"
                                    VerticalAlignment="Bottom"/>

                            <TextBlock Grid.Row="4"
                                       Text="Weekly Product Totals (After Entry)"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#0B1530"
                                       Margin="0,4,0,0"/>

                            <Canvas x:Name="WeeklyBarCanvas"
                                    Grid.Row="5"
                                    Height="235"
                                    Margin="0,12,0,10"
                                    SizeChanged="WeeklyBarCanvas_SizeChanged"/>

                            <Border Grid.Row="6"
                                    BorderBrush="#E1E8F0"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,12,0,0">

                                <TextBlock Text="Preview only. Changes apply after you save the entry. Current week only."
                                           FontSize="12"
                                           Foreground="#526482"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"/>

                            </Border>

                        </Grid>

                    </Border>

                </UniformGrid>

            </StackPanel>

        </ScrollViewer>

        <!-- ================================================
             ADD / EDIT PRODUCT OVERLAY
             ================================================ -->

        <Grid x:Name="ProductEditorOverlay"
              Background="#990B1530"
              Visibility="Collapsed"
              Panel.ZIndex="10">

            <Border Width="440"
                    Padding="25"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#DCE5EF"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock x:Name="ProductEditorTitle"
                               Text="Add Product"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#0B1530"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Choose a category to see its compatible selling units."
                               FontSize="12"
                               Foreground="#526482"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <!-- PRODUCT NAME -->
                    <TextBlock Text="PRODUCT NAME"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="EditorNameInput"
                             Style="{StaticResource SSInputStyle}"
                             Height="40"
                             Padding="12,0"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,16"/>

                    <!-- CATEGORY DROPDOWN -->
                    <TextBlock Text="CATEGORY"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="EditorCategoryComboBox"
                              Style="{StaticResource ProductEditorComboStyle}"
                              MaxDropDownHeight="260"
                              SelectionChanged="EditorCategoryComboBox_SelectionChanged"/>

                    <!-- SELLING UNIT DROPDOWN -->
                    <TextBlock Text="SELLING UNIT"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="EditorUnitComboBox"
                              Style="{StaticResource ProductEditorComboStyle}"
                              MaxDropDownHeight="230"
                              IsEnabled="False"/>

                    <!-- VALIDATION MESSAGE -->
                    <TextBlock x:Name="ProductEditorErrorText"
                               Visibility="Collapsed"
                               Foreground="#C74747"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- EDITOR BUTTONS -->
                    <Grid Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Height="42"
                                Style="{StaticResource SSOutlineButtonStyle}"
                                Click="CancelProductEditorButton_Click"/>

                        <Button Grid.Column="2"
                                Content="Save Product"
                                Height="42"
                                Style="{StaticResource SSPrimaryButtonStyle}"
                                Click="SaveProductEditorButton_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>