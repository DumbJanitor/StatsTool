<UserControl x:Class="StatsTool.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <!--
        SALESSCOPE - LOGIN VIEW

        FRONTEND:
        - This view is displayed inside MainWindow.AuthContent.
        - MainWindow already handles the window controls.
        - All navigation remains inside the existing MainWindow.
        - Viewbox allows the login panel to shrink on smaller screens.
        - Keep username fully readable by overriding vertical input padding.
        - Show/Hide affects only the password field, never the username.

        BACKEND TEAM:
        - Connect the Login button to the authentication service.
        - Verify credentials securely.
        - Establish the authenticated user session.
        - Implement the Remember Me behavior.
        - Never store passwords in plain text.
        - PasswordInput remains the password source for authentication,
          including after the user switches between Show and Hide.

        DATABASE TEAM:
        - Supply the user account records needed for authentication.
        - Coordinate password hashing and verification with backend.
        - This view must not access the database directly.
    -->

    <Grid Background="White">

        <Viewbox Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="25,55,25,35">

            <Border Width="420"
                    Padding="34,25,34,30"
                    Background="White"
                    BorderBrush="#E1E6ED"
                    BorderThickness="1"
                    CornerRadius="12">

                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="18"
                                      ShadowDepth="2"
                                      Opacity="0.09"/>
                </Border.Effect>

                <StackPanel>

                    <!-- BACK BUTTON -->
                    <Button Content="← Back"
                            Click="BackButton_Click"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#61718D"
                            FontSize="13"
                            Cursor="Hand"
                            Padding="0"
                            Margin="0,0,0,18"/>

                    <!-- LOGO -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,26">

                        <!-- Vector logo: no PNG dependency -->
                        <Grid Width="34"
                              Height="34"
                              Margin="0,0,9,0">

                            <Ellipse Fill="#009F91"/>

                            <Path Data="M 17,0 L 17,17 L 34,17
                                        M 17,17 L 29,29"
                                  Stroke="White"
                                  StrokeThickness="2.7"/>

                        </Grid>

                        <TextBlock Text="SalesScope"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#0B1530"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- USERNAME: visible text, no masking or clipping -->
                    <TextBlock Text="USERNAME"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource SSInputStyle}"
                             Height="42"
                             Margin="0,0,0,18"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             MaxLength="100"/>

                    <!-- PASSWORD: password box and visible textbox share
                         the same space. Only one is visible at a time. -->
                    <TextBlock Text="PASSWORD"
                               Style="{StaticResource SSFormLabelStyle}"
                               Margin="0,0,0,6"/>

                    <Grid Height="42" Margin="0,0,0,14">

                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource SSPasswordStyle}"
                                     Height="42"
                                     Padding="12,0,58,0"
                                     VerticalContentAlignment="Center"/>

                        <TextBox x:Name="VisiblePasswordTextBox"
                                 Style="{StaticResource SSInputStyle}"
                                 Height="42"
                                 Padding="12,0,58,0"
                                 VerticalContentAlignment="Center"
                                 Visibility="Collapsed"/>

                        <Button x:Name="PasswordVisibilityButton"
                                Content="Show"
                                Click="PasswordVisibilityButton_Click"
                                Width="54"
                                Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#008E83"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Show or hide password"/>

                    </Grid>

                    <!-- REMEMBER ME -->
                    <CheckBox x:Name="RememberMeCheckBox"
                              Content="Remember me"
                              FontSize="12"
                              Foreground="#0B1530"
                              Margin="0,0,0,18"
                              VerticalAlignment="Center"/>

                    <!-- INLINE VALIDATION MESSAGE -->
                    <TextBlock x:Name="FeedbackText"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Foreground="#C33B3B"
                               FontSize="12"
                               Margin="0,0,0,12"/>

                    <!-- LOGIN -->
                    <Button x:Name="LoginButton"
                            Content="Login"
                            Style="{StaticResource SSPrimaryButtonStyle}"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            Click="LoginButton_Click"
                            Margin="0,0,0,16"/>

                    <!-- SIGN UP NAVIGATION -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Don't have an account?"
                                   Foreground="#0B1530"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <Button Content="Sign up"
                                Click="SignUpButton_Click"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#008E83"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="5,0,0,0"
                                VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Viewbox>

    </Grid>

</UserControl>