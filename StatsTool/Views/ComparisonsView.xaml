<UserControl x:Class="StatsTool.Views.ComparisonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAFBFD"
             FontFamily="Segoe UI">

    <!-- FRONTEND TEAM:
         Hosted in MainWindow.MainContent. The app header, sidebar,
         logout, hamburger, and window controls remain in MainWindow.
         Preserve the two week cards, chart, summary, and responsive layout.

         BACKEND TEAM:
         Supply recorded reporting weeks and calculated comparisons
         through a service. Both selectors must use recorded weeks.

         DATABASE TEAM:
         Maintain account-scoped products, sales records, and queries
         for recorded Monday-Sunday reporting weeks.
         Do not put SQL in this XAML. -->

    <UserControl.Resources>
        <SolidColorBrush x:Key="CmpInk" Color="#0B1738"/>
        <SolidColorBrush x:Key="CmpTeal" Color="#0AA88D"/>
        <SolidColorBrush x:Key="CmpBlue" Color="#173AA1"/>
        <SolidColorBrush x:Key="CmpMint" Color="#73D6BF"/>

        <Style x:Key="CmpCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DAE5F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="CmpCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource CmpInk}"/>
        </Style>

        <Style x:Key="CmpFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CmpInk}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Both week selectors use this same dropdown style. -->
        <Style x:Key="CmpFilterComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource CmpInk}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDCAEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="225"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="IsEditable" Value="False"/>
        </Style>

        <Style x:Key="CmpPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#008E80"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00796F"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CmpTableHeadStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource CmpInk}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid x:Name="PageRoot"
              Margin="20"
              SizeChanged="PageRoot_SizeChanged">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- PAGE HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Comparisons"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource CmpInk}"/>

                <TextBlock Text="Compare recorded product sales between two weeks"
                           FontSize="16"
                           Foreground="{StaticResource CmpBlue}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- WEEK SELECTION -->
            <WrapPanel Grid.Row="1"
                       Margin="0,0,0,15"
                       VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,17,10"
                            VerticalAlignment="Center">

                    <TextBlock Text="Current Week"
                               Style="{StaticResource CmpFilterLabelStyle}"
                               Margin="0,0,12,0"/>

                    <ComboBox x:Name="CurrentWeekComboBox"
                              Style="{StaticResource CmpFilterComboStyle}"
                              SelectionChanged="CurrentWeekComboBox_SelectionChanged"
                              ToolTip="Choose a recorded reporting week"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,17,10"
                            VerticalAlignment="Center">

                    <TextBlock Text="Compare With"
                               Style="{StaticResource CmpFilterLabelStyle}"
                               Margin="0,0,12,0"/>

                    <ComboBox x:Name="CompareWithComboBox"
                              Style="{StaticResource CmpFilterComboStyle}"
                              ToolTip="Choose an earlier recorded reporting week"/>
                </StackPanel>

                <Button Content="Compare Weeks"
                        Style="{StaticResource CmpPrimaryButtonStyle}"
                        Margin="0,0,0,10"
                        Click="CompareWeeksButton_Click"/>
            </WrapPanel>

            <TextBlock x:Name="ComparisonStatusText"
                       Grid.Row="2"
                       Visibility="Collapsed"
                       Margin="0,0,0,12"
                       Foreground="#9F4B26"
                       FontSize="14"
                       TextWrapping="Wrap"/>

            <!-- MAIN COMPARISON BODY -->
            <Grid x:Name="BodyGrid" Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: WEEK TABLES AND CHART -->
                <Grid x:Name="MainComparisonColumn"
                      Grid.Row="0"
                      Grid.Column="0"
                      Margin="0,0,14,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="WeekCardsGrid" Grid.Row="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CURRENT WEEK -->
                        <Border x:Name="CurrentWeekCard"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,7,0"
                                Style="{StaticResource CmpCardStyle}">

                            <StackPanel>
                                <TextBlock Text="Current Week"
                                           Style="{StaticResource CmpCardTitleStyle}"/>

                                <TextBlock x:Name="CurrentWeekDateText"
                                           FontSize="14"
                                           Foreground="{StaticResource CmpBlue}"
                                           Margin="0,1,0,10"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Bottom">
                                        <TextBlock x:Name="CurrentTotalText"
                                                   Text="284"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CmpTeal}"/>
                                        <TextBlock Text=" units sold"
                                                   FontSize="12"
                                                   Margin="5,0,0,5"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#B9C9E9"
                                            Height="34"
                                            VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom">
                                        <TextBlock x:Name="CurrentProductCountText"
                                                   Text="5"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CmpTeal}"/>
                                        <TextBlock Text=" products"
                                                   FontSize="12"
                                                   Margin="5,0,0,5"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#E9EEF3"
                                        CornerRadius="5"
                                        Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Product"
                                                   Style="{StaticResource CmpTableHeadStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Units"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource CmpTableHeadStyle}"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="CurrentProductsList"/>
                            </StackPanel>
                        </Border>

                        <!-- SELECTED WEEK -->
                        <Border x:Name="SelectedWeekCard"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="7,0,0,0"
                                Style="{StaticResource CmpCardStyle}">

                            <StackPanel>
                                <TextBlock Text="Selected Week"
                                           Style="{StaticResource CmpCardTitleStyle}"/>

                                <TextBlock x:Name="SelectedWeekDateText"
                                           FontSize="14"
                                           Foreground="{StaticResource CmpBlue}"
                                           Margin="0,1,0,10"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Bottom">
                                        <TextBlock x:Name="SelectedTotalText"
                                                   Text="270"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CmpTeal}"/>
                                        <TextBlock Text=" units sold"
                                                   FontSize="12"
                                                   Margin="5,0,0,5"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#B9C9E9"
                                            Height="34"
                                            VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom">
                                        <TextBlock x:Name="SelectedProductCountText"
                                                   Text="5"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CmpTeal}"/>
                                        <TextBlock Text=" products"
                                                   FontSize="12"
                                                   Margin="5,0,0,5"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#E9EEF3"
                                        CornerRadius="5"
                                        Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Product"
                                                   Style="{StaticResource CmpTableHeadStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Units"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource CmpTableHeadStyle}"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="SelectedProductsList"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PRODUCT SALES COMPARISON CHART -->
                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Style="{StaticResource CmpCardStyle}">

                        <StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <TextBlock Text="Product Sales Comparison"
                                           Style="{StaticResource CmpCardTitleStyle}"
                                           Margin="0,0,22,8"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,6,18,8">
                                    <Border Background="#008C79"
                                            Width="17"
                                            Height="13"
                                            CornerRadius="3"
                                            Margin="0,0,6,0"/>
                                    <TextBlock Text="Current Week"
                                               FontSize="13"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,6,0,8">
                                    <Border Background="{StaticResource CmpMint}"
                                            Width="17"
                                            Height="13"
                                            CornerRadius="3"
                                            Margin="0,0,6,0"/>
                                    <TextBlock Text="Selected Week"
                                               FontSize="13"/>
                                </StackPanel>
                            </WrapPanel>

                            <Border Background="#EDF1F5"
                                    CornerRadius="5"
                                    HorizontalAlignment="Right"
                                    Padding="10,4"
                                    Margin="0,0,0,4">
                                <TextBlock Text="Difference"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CmpInk}"/>
                            </Border>

                            <StackPanel x:Name="ProductChartRows"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- RIGHT: COMPARISON SUMMARY -->
                <Border x:Name="SummaryCard"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource CmpCardStyle}">

                    <StackPanel>
                        <TextBlock Text="Comparison Summary"
                                   Style="{StaticResource CmpCardTitleStyle}"
                                   Margin="0,0,0,17"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Current Week"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SummaryCurrentText"
                                       Grid.Column="1"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CmpTeal}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Selected Week"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SummarySelectedText"
                                       Grid.Column="1"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CmpTeal}"/>
                        </Grid>

                        <Border Height="1"
                                Background="#E2EAF3"
                                Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Difference"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SummaryDifferenceText"
                                       Grid.Column="1"
                                       FontSize="23"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Border Height="1"
                                Background="#E2EAF3"
                                Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Percentage Change"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SummaryPercentageText"
                                       Grid.Column="1"
                                       FontSize="23"
                                       FontWeight="Bold"/>
                        </Grid>

                        <Border Background="#BBCDEA"
                                Height="1"
                                Margin="0,0,0,18"/>

                        <TextBlock Text="Interpretation"
                                   Style="{StaticResource CmpCardTitleStyle}"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="InterpretationText"
                                   FontSize="15"
                                   Foreground="#202B40"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <Border x:Name="LargestIncreaseBorder"
                                Background="#DFF7F1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,20">
                            <TextBlock x:Name="LargestIncreaseText"
                                       FontSize="15"
                                       Foreground="{StaticResource CmpInk}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Based on recorded quantities only."
                                   FontSize="13"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource CmpBlue}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>