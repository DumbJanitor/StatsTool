<UserControl x:Class="StatsTool.Views.SettingsView"
             x:Name="SettingsViewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             FontFamily="Segoe UI">

    <!-- ============================================================
         FRONTEND TEAM — ACCOUNT SETTINGS
         ============================================================

         Follow the approved Settings wireframe.

         This page contains ONLY:
         1. Username
         2. Email Address
         3. Optional new password
         4. Save Changes
         5. Delete Account

         MainWindow already handles:
         - Top application bar
         - SalesScope logo
         - Sidebar navigation
         - Logout
         - Minimize / Maximize / Close

         Do not duplicate those components here.

         The fields and layout respond to window resizing.
         Both action buttons use the same width and height.

         ============================================================
         BACKEND TEAM — ACCOUNT SERVICES
         ============================================================

         1. Retrieve the authenticated user's account information.
         2. Populate UsernameTextBox and EmailTextBox.
         3. Validate account changes.
         4. Update username and email through the account service.
         5. Update password ONLY when a new password is supplied.
         6. Require re-authentication for sensitive changes if needed.
         7. Implement account deletion with confirmation.
         8. Only navigate away after successful backend deletion.

         The current example account details are PLACEHOLDERS.

         ============================================================
         DATABASE TEAM — ACCOUNT STORAGE
         ============================================================

         1. Maintain unique username and email constraints.
         2. Store password hashes, NEVER plaintext passwords.
         3. Coordinate account-update operations with backend.
         4. Define what happens to associated sales and inventory
            records when an account is deleted.
         5. Ensure database operations respect account ownership.

         No database connection should be implemented in XAML.
         ============================================================ -->

    <UserControl.Resources>

        <!-- =====================================================
             SALESCOPE COLORS
             ===================================================== -->

        <SolidColorBrush x:Key="SetInk"
                         Color="#0B1738"/>

        <SolidColorBrush x:Key="SetMuted"
                         Color="#526586"/>

        <!-- =====================================================
             FIELD LABEL STYLE
             ===================================================== -->

        <Style x:Key="SetLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SetInk}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

        <!-- =====================================================
             TEXTBOX STYLE
             ===================================================== -->

        <Style x:Key="SetTextBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SetInk}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#B9C9E6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- =====================================================
             PASSWORD BOX STYLE
             ===================================================== -->

        <Style x:Key="SetPasswordBox"
               TargetType="PasswordBox">

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SetInk}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#B9C9E6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- =====================================================
             SHARED BUTTON STYLE

             IMPORTANT:
             Save Changes and Delete Account have IDENTICAL sizes.
             ===================================================== -->

        <Style x:Key="SetActionButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="220"/>

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <!-- =========================================================
         RESPONSIVE PAGE
         ========================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid x:Name="PageRoot"
              MinHeight="{Binding ActualHeight,
                                  ElementName=SettingsViewRoot}"
              SizeChanged="PageRoot_SizeChanged">

            <!-- =================================================
                 MAIN SETTINGS CARD
                 ================================================= -->

            <Border x:Name="SettingsCard"
                    MaxWidth="980"
                    Margin="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#CBD9EE"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="30">

                <StackPanel>

                    <!-- ACCOUNT SETTINGS TITLE -->

                    <TextBlock Text="Account Settings"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource SetInk}"
                               Margin="0,0,0,24"/>

                    <!-- =========================================
                         USERNAME
                         ========================================= -->

                    <Grid x:Name="UsernameRow"
                          Margin="0,0,0,18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="UsernameLabel"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Username"
                                   Style="{StaticResource SetLabel}"/>

                        <TextBox x:Name="UsernameTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Text="admin_store"
                                 MaxLength="100"
                                 Style="{StaticResource SetTextBox}"/>

                    </Grid>

                    <!-- =========================================
                         EMAIL ADDRESS
                         ========================================= -->

                    <Grid x:Name="EmailRow"
                          Margin="0,0,0,18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="EmailLabel"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Email Address"
                                   Style="{StaticResource SetLabel}"/>

                        <TextBox x:Name="EmailTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Text="admin@example.com"
                                 MaxLength="254"
                                 Style="{StaticResource SetTextBox}"/>

                    </Grid>

                    <!-- =========================================
                         OPTIONAL PASSWORD CHANGE
                         ========================================= -->

                    <Grid x:Name="PasswordRow"
                          Margin="0,0,0,22">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PasswordLabel"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Password"
                                   Style="{StaticResource SetLabel}"/>

                        <Grid x:Name="PasswordFieldGrid"
                              Grid.Row="0"
                              Grid.Column="1">

                            <PasswordBox x:Name="NewPasswordBox"
                                         Style="{StaticResource SetPasswordBox}"
                                         PasswordChanged="NewPasswordBox_PasswordChanged"/>

                            <!-- WPF PasswordBox has no PlaceholderText.
                                 This overlay provides the placeholder. -->

                            <TextBlock x:Name="PasswordHint"
                                       Text="New password (optional)"
                                       FontSize="17"
                                       Foreground="#7586A5"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                        </Grid>

                    </Grid>

                    <!-- =========================================
                         SAVE CHANGES
                         ========================================= -->

                    <Button x:Name="SaveChangesButton"
                            Content="Save Changes"
                            Style="{StaticResource SetActionButton}"
                            HorizontalAlignment="Right"
                            Background="#009C8A"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SaveChangesButton_Click"/>

                    <!-- Appears only after validation or action. -->

                    <TextBlock x:Name="StatusText"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               FontSize="13"
                               Foreground="{StaticResource SetMuted}"/>

                    <!-- =========================================
                         DIVIDER
                         ========================================= -->

                    <Border Height="1"
                            Background="#DEE7F3"
                            Margin="0,30,0,22"/>

                    <!-- =========================================
                         DELETE ACCOUNT
                         ========================================= -->

                    <Grid x:Name="DeleteRow">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="DeleteInfo"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,18,0">

                            <TextBlock Text="Delete Account"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SetInk}"/>

                            <TextBlock
                                Text="Permanently remove your account and its access."
                                FontSize="15"
                                Foreground="{StaticResource SetMuted}"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                        <Button x:Name="DeleteAccountButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Content="Delete Account"
                                Style="{StaticResource SetActionButton}"
                                Background="White"
                                Foreground="#E02A22"
                                BorderBrush="#E02A22"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Click="DeleteAccountButton_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>